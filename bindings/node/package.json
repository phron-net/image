{
  "name": "@phron/image",
  "version": "0.1.0",
  "description": "Build and sign Phron Image URLs. A Rust core, bound to Node.js through napi-rs.",
  "keywords": [
    "phron",
    "image",
    "signed-url",
    "hmac",
    "nextjs",
    "napi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phron-net/image.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/phron-net/image#readme",
  "bugs": "https://github.com/phron-net/image/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native.cjs",
    "native.d.cts"
  ],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "phron-image",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:native": "napi build --platform --release --js native.cjs --dts native.d.cts",
    "build:native:debug": "napi build --platform --js native.cjs --dts native.d.cts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
