{
  "name": "@phron/image",
  "version": "0.2.0",
  "description": "Build and sign Phron Image URLs. A Rust core, bound through napi-rs: native on Linux x64, WebAssembly everywhere else.",
  "keywords": [
    "phron",
    "image",
    "signed-url",
    "hmac",
    "nextjs",
    "napi"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phron-net/image.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/phron-net/image#readme",
  "bugs": "https://github.com/phron-net/image/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "native.cjs",
    "native.d.cts"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "napi": {
    "binaryName": "phron-image",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "wasm32-wasip1"
    ],
    "wasm": {
      "cpu": false
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:native": "napi build --platform --release --js native.cjs --dts native.d.cts",
    "build:native:debug": "napi build --platform --js native.cjs --dts native.d.cts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.3",
    "@emnapi/runtime": "^2.0.0-beta.3",
    "@napi-rs/cli": "^3.10.12",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@types/node": "^22.0.0",
    "emnapi": "^2.0.0-beta.3",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
