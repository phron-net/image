{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!target",
      "!**/native.cjs",
      "!**/native.d.cts",
      "!**/npm",
      "!**/phron-image.*",
      "!**/wasi-worker*.mjs",
      "!bindings/node/browser.js",
      "!.playwright-cli",
      "!.claude",
      "!.agents",
      "!.handover",
      "!.scratch",
      "!.sampo/changesets",
      "!**/CHANGELOG.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } }
}
